NEXT_PUBLIC_API_URL=/api
ENABLE_API_PROXY=1
# Для Docker: DEV_API_PROXY_TARGET=http://backend:8000
DEV_API_PROXY_TARGET=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dev-anon-key
# Dev auth bypass (set to 1 to skip Supabase auth locally)
NEXT_PUBLIC_DEV_BYPASS_AUTH=1
NEXT_PUBLIC_DEV_USER_EMAIL=dev@example.com
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001
