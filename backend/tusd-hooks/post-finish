#!/bin/bash
#
# Tusd Post-Finish Hook - Move File to User Directory and Notify Backend
#
# This hook is called AFTER tusd completes the upload.
# It moves the file from _temp to the user's directory and notifies the backend.
#
set -e

base64_decode() {
    base64 --decode 2>/dev/null || base64 -d 2>/dev/null || base64 -D 2>/dev/null
}

resolve_backend_base() {
    local base="${TUSD_BACKEND_URL:-http://localhost:8000}"
    printf '%s' "${base%/}"
}

resolve_upload_root() {
    if [ -n "${TUSD_UPLOAD_ROOT:-}" ]; then
        printf '%s' "${TUSD_UPLOAD_ROOT%/}"
        return 0
    fi

    if [ -d "/app/uploads" ]; then
        printf '%s' "/app/uploads"
        return 0
    fi

    local script_dir
    script_dir="$(cd "$(dirname "$0")" && pwd)"
    printf '%s' "$(cd "$script_dir/.." && pwd)/uploads"
}

resolve_user_from_token() {
    local token="$1"

    if [ -z "${UPLOAD_TOKEN_SECRET:-}" ]; then
        echo "[post-finish] ERROR: UPLOAD_TOKEN_SECRET is not set" >&2
        return 1
    fi

    local sanitized
    sanitized=$(printf '%s' "$token" | tr -d '\r\n')
    if [ -z "$sanitized" ]; then
        echo "[post-finish] ERROR: Upload token missing" >&2
        return 1
    fi

    local decoded
    if ! decoded=$(printf '%s' "$sanitized" | base64_decode); then
        echo "[post-finish] ERROR: Failed to decode upload token" >&2
        return 1
    fi

    local payload="${decoded%:*}"
    local signature="${decoded##*:}"
    local expected
    expected=$(printf '%s' "$payload" | openssl dgst -sha256 -hmac "$UPLOAD_TOKEN_SECRET" | awk '{print $NF}')
    if [ "$signature" != "$expected" ]; then
        echo "[post-finish] ERROR: Upload token signature mismatch" >&2
        return 1
    fi

    local user_id
    user_id=$(printf '%s' "$payload" | cut -d':' -f1)
    local expires_at
    expires_at=$(printf '%s' "$payload" | cut -d':' -f2)
    if [ -z "$user_id" ] || [ -z "$expires_at" ]; then
        echo "[post-finish] ERROR: Upload token missing fields" >&2
        return 1
    fi

    local now
    now=$(date +%s)
    if [ "$expires_at" -le "$now" ]; then
        echo "[post-finish] ERROR: Upload token expired" >&2
        return 1
    fi

    printf '%s' "$user_id"
}

# Read webhook data from stdin (може бути багаторядковим)
HOOK_DATA=$(cat)

if [ -z "$HOOK_DATA" ]; then
    echo "[post-finish] ERROR: empty payload from tusd" >&2
    exit 0
fi

# Extract metadata
TOKEN_METADATA=$(echo "$HOOK_DATA" | jq -r '.Event.Upload.MetaData.upload_token // .Upload.MetaData.upload_token // empty')
USER_ID_METADATA=$(echo "$HOOK_DATA" | jq -r '.Event.Upload.MetaData.user_id // .Upload.MetaData.user_id // empty')
UPLOAD_ID=$(echo "$HOOK_DATA" | jq -r '.Event.Upload.ID // .Upload.ID // empty')
FILENAME=$(echo "$HOOK_DATA" | jq -r '.Event.Upload.MetaData.filename // .Upload.MetaData.filename // .Upload.MetaData.name // empty')

# Debug logging
echo "[post-finish] Upload ID: $UPLOAD_ID" >&2
echo "[post-finish] User ID (metadata): $USER_ID_METADATA" >&2
echo "[post-finish] Filename: $FILENAME" >&2

# Validate token
if [ -z "$TOKEN_METADATA" ] || [ "$TOKEN_METADATA" = "null" ]; then
    echo "[post-finish] ERROR: Missing upload token in metadata" >&2
    exit 0
fi

RESOLVED_USER_ID=$(resolve_user_from_token "$TOKEN_METADATA") || exit 0

if [ -n "$USER_ID_METADATA" ] && [ "$USER_ID_METADATA" != "$RESOLVED_USER_ID" ]; then
    echo "[post-finish] WARNING: user_id metadata ($USER_ID_METADATA) mismatches token owner ($RESOLVED_USER_ID)" >&2
fi

USER_ID="$RESOLVED_USER_ID"
echo "[post-finish] Resolved User ID: $USER_ID" >&2

# Define paths (absolute to avoid cwd issues)
UPLOAD_ROOT="$(resolve_upload_root)"
TEMP_DIR="$UPLOAD_ROOT/_temp"
USER_DIR="$UPLOAD_ROOT/$USER_ID"

STORAGE_PATH=$(echo "$HOOK_DATA" | jq -r '.Storage.Path // .Event.Upload.Storage.Path // .Upload.Storage.Path // empty')
STORAGE_INFO_PATH=$(echo "$HOOK_DATA" | jq -r '.Storage.InfoPath // .Event.Upload.Storage.InfoPath // .Upload.Storage.InfoPath // empty')

if [ -n "$STORAGE_PATH" ] && [ "$STORAGE_PATH" != "null" ]; then
    TEMP_FILE="$STORAGE_PATH"
else
    TEMP_FILE="$TEMP_DIR/$UPLOAD_ID"
    if [ ! -f "$TEMP_FILE" ]; then
        TEMP_FILE="$UPLOAD_ROOT/$UPLOAD_ID"
    fi
fi

if [ -n "$STORAGE_INFO_PATH" ] && [ "$STORAGE_INFO_PATH" != "null" ]; then
    TEMP_INFO="$STORAGE_INFO_PATH"
else
    TEMP_INFO="${TEMP_FILE}.info"
fi

FINAL_FILE="$USER_DIR/$UPLOAD_ID"
FINAL_INFO="$USER_DIR/$UPLOAD_ID.info"

echo "[post-finish] Temp file: $TEMP_FILE" >&2
echo "[post-finish] Final file: $FINAL_FILE" >&2

# Create user directory if it doesn't exist
if [ ! -d "$USER_DIR" ]; then
    echo "[post-finish] Creating user directory: $USER_DIR" >&2
    mkdir -p "$USER_DIR"
    chmod 700 "$USER_DIR"
fi

# Move file from _temp to user directory
if [ -f "$TEMP_FILE" ]; then
    echo "[post-finish] Moving file to user directory..." >&2
    mv "$TEMP_FILE" "$FINAL_FILE"
    
    # Move .info file if exists
    if [ -f "$TEMP_INFO" ]; then
        mv "$TEMP_INFO" "$FINAL_INFO"
    fi
    
    # Update storage path in webhook data
    UPDATED_DATA=$(echo "$HOOK_DATA" | jq \
        --arg path "$FINAL_FILE" \
        '.Storage.Path = $path')
    
    echo "[post-finish] File moved successfully" >&2
else
    echo "[post-finish] WARNING: Temp file not found at $TEMP_FILE" >&2
    
    # Check if file already in user directory (maybe moved by tusd)
    if [ -f "$FINAL_FILE" ]; then
        echo "[post-finish] File already in user directory" >&2
        UPDATED_DATA="$HOOK_DATA"
    else
        echo "[post-finish] ERROR: File not found in temp or user directory!" >&2
        exit 0  # Don't fail the upload
    fi
fi

# Notify backend via webhook
BACKEND_URL="$(resolve_backend_base)/api/assets/upload-complete"
PAYLOAD="${UPDATED_DATA:-$HOOK_DATA}"

echo "[post-finish] Notifying backend..." >&2

HOOK_HEADERS=(-H "Content-Type: application/json")
if [ -n "${TUSD_HMAC_SECRET:-}" ]; then
    HOOK_SIGNATURE=$(printf '%s' "$PAYLOAD" | openssl dgst -sha256 -hmac "$TUSD_HMAC_SECRET" | awk '{print $NF}')
    HOOK_HEADERS+=(-H "X-Tusd-Signature: $HOOK_SIGNATURE")
else
    echo "[post-finish] WARNING: TUSD_HMAC_SECRET is not set; sending unsigned webhook" >&2
fi

set +e
WEBHOOK_RESPONSE=$(curl -s -X POST "$BACKEND_URL" \
    "${HOOK_HEADERS[@]}" \
    -d "$PAYLOAD" 2>&1)
CURL_EXIT_CODE=$?
set -e

if [ $CURL_EXIT_CODE -ne 0 ]; then
    echo "[post-finish] ERROR: Failed to notify backend" >&2
    echo "[post-finish] Curl exit code: $CURL_EXIT_CODE" >&2
    echo "[post-finish] Response: $WEBHOOK_RESPONSE" >&2
else
    echo "[post-finish] Backend notified successfully" >&2
    echo "[post-finish] Response: $WEBHOOK_RESPONSE" >&2
fi

# Get file size
if [ -f "$FINAL_FILE" ]; then
    FILE_SIZE=$(stat -f%z "$FINAL_FILE" 2>/dev/null || stat -c%s "$FINAL_FILE" 2>/dev/null || echo "unknown")
    echo "[post-finish] Final file size: $FILE_SIZE bytes" >&2
fi

echo "[post-finish] Upload complete!" >&2

exit 0
