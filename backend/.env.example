# ============================================
# TEMPLATE FILE - NOT FOR PRODUCTION USE
# Copy to .env and replace with real values
# ============================================

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Supabase - Get from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_KEY=PASTE_YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE
# Cache Supabase user lookups (seconds, max entries, leeway before expiry)
SUPABASE_USER_CACHE_TTL_SECONDS=60
SUPABASE_USER_CACHE_MAX_ENTRIES=512
SUPABASE_USER_CACHE_EXPIRY_LEEWAY_SECONDS=5

# Database (Supabase PostgreSQL) - Get connection string from Supabase
# IMPORTANT: Use port 5432 (Session Mode), NOT 6543 (Transaction Mode incompatible with asyncpg)
DATABASE_URL=postgresql://postgres.XXXXX:PASTE_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_USE_NULL_POOL=false
DB_ECHO_SQL=false

# Security & Encryption
# Generate encryption key with: openssl rand -hex 32
ENCRYPTION_KEY=GENERATE_RANDOM_32_CHAR_KEY_HERE_DO_NOT_USE_THIS_EXAMPLE
# Generate encryption salt with: openssl rand -hex 16
ENCRYPTION_SALT=GENERATE_RANDOM_SALT_HERE_DO_NOT_USE_THIS_EXAMPLE
DOWNLOAD_TOKEN_SECRET=GENERATE_RANDOM_DOWNLOAD_TOKEN_SECRET

# Supabase JWT Secret (from Supabase Dashboard -> Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=PASTE_YOUR_JWT_SECRET_FROM_SUPABASE_DASHBOARD_HERE

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
UPLOAD_DIR=./uploads
STREAM_DIR=./streams
MAX_UPLOAD_SIZE=10737418240  # 10GB

# FFmpeg
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# Monitoring
SENTRY_DSN=  # Optional

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Internal Integrations
TUSD_HMAC_SECRET=CHANGE_ME_HMAC_SECRET
