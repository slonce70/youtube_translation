# ============================================
# DEVELOPMENT CONFIGURATION
# Copy to .env and update with your values
# ============================================

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENVIRONMENT=development  # development, staging, production

# Database (Local PostgreSQL for Development / hybrid local boot)
# For local development: postgresql://user:password@localhost:5432/dbname
# For production: Use strong password and consider connection pooling
# The recommended local flow is: `make dev-bootstrap` -> `./start-backend.sh` -> `./start-frontend.sh`
DATABASE_URL=postgresql://youtube_user:dev_password_local_only@localhost:5432/youtube_streaming
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_USE_NULL_POOL=false
DB_ECHO_SQL=false

# Supabase Authentication (ONLY for Auth, not for Database!)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
# User cache settings
SUPABASE_USER_CACHE_TTL_SECONDS=60
SUPABASE_USER_CACHE_MAX_ENTRIES=512
SUPABASE_USER_CACHE_EXPIRY_LEEWAY_SECONDS=5
ENABLE_DEV_AUTH=false
# Set to true for local smoke tests to bypass Supabase auth verification.
# Pair with frontend/.env.local => NEXT_PUBLIC_DEV_BYPASS_AUTH=1.
DEV_USER_EMAIL=dev@example.com
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Security & Encryption
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=GENERATE_RANDOM_32_CHAR_KEY_HERE
# Generate: openssl rand -hex 16
ENCRYPTION_SALT=GENERATE_RANDOM_16_CHAR_SALT_HERE
DOWNLOAD_TOKEN_SECRET=GENERATE_RANDOM_DOWNLOAD_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Paths
UPLOAD_DIR=./uploads
STREAM_DIR=./streams
MAX_UPLOAD_SIZE=10737418240  # 10GB

# FFmpeg Configuration
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg  # macOS with Homebrew
FFPROBE_BIN=/opt/homebrew/bin/ffprobe
# For Linux: /usr/bin/ffmpeg and /usr/bin/ffprobe

# FFmpeg Stream Management
FFMPEG_AUTO_RESTART_ATTEMPTS=1
FFMPEG_RESTART_BACKOFF_SECONDS=5
FFMPEG_VIDEO_BITRATE_KBPS=6000
FFMPEG_VIDEO_MAXRATE_KBPS=7500
FFMPEG_VIDEO_BUFSIZE_KBPS=12000
FFMPEG_AUDIO_BITRATE_KBPS=160
FFMPEG_KEYFRAME_INTERVAL_SECONDS=2.0  # YouTube/Twitch recommend 2s, max 4s
FFMPEG_TEE_ONFAIL_POLICY=ignore  # ignore keeps other destinations alive when one output fails
FFMPEG_CLEANUP_INTERVAL_SECONDS=60

# Placeholder Assets (optional)
PLACEHOLDER_VIDEO_PATH=
PLACEHOLDER_AUDIO_PATH=
PLACEHOLDER_VIDEO_RESOLUTION=1280x720
PLACEHOLDER_VIDEO_FPS=30
PLACEHOLDER_VIDEO_COLOR=black
PLACEHOLDER_AUDIO_SAMPLE_RATE=44100
PLACEHOLDER_AUDIO_CHANNEL_LAYOUT=stereo

# Stream Runtime Mode
# Options: manager | supervisor | systemd
# - manager: FFmpeg runs as subprocess (simple, good for dev)
# - supervisor: FFmpeg managed by supervisord (good for macOS/Docker)
# - systemd: FFmpeg managed by systemd units (good for Linux production)
# For the current tranche-one launch, keep backend + tusd + runner + uploads on the same host.
# Recommended for hybrid local boot. start-backend.sh falls back to manager
# when supervisor tooling is unavailable on the host.
STREAM_RUNTIME_MODE=supervisor
STREAM_RUNTIME_NODE_ID=local-dev-node
# Safety valve: manager runtime is blocked in staging/production unless explicitly enabled.
ALLOW_UNSAFE_MANAGER_RUNTIME=false
STREAM_RUNTIME_LEASE_TTL_SECONDS=60
STREAM_RUNTIME_HEARTBEAT_INTERVAL_SECONDS=10
STREAM_RUNTIME_HEARTBEAT_TTL_SECONDS=45
STREAM_RUNTIME_AUTO_RESTART_ENABLED=true
STREAM_RUNTIME_RESTART_MAX_ATTEMPTS=5
STREAM_RUNTIME_RESTART_BACKOFF_SECONDS=5
STREAM_RUNTIME_RESTART_BACKOFF_MAX_SECONDS=300
STREAM_RUNTIME_RESTART_JITTER_SECONDS=3
STREAM_RUNTIME_RESTART_RESET_AFTER_SECONDS=900

# Supervisor Configuration (if STREAM_RUNTIME_MODE=supervisor)
SUPERVISOR_PROGRAM_TEMPLATE=stream_{stream_id}
SUPERVISOR_CTL_PATH=supervisorctl
SUPERVISOR_CONF_PATH=supervisord.conf
SUPERVISOR_CONFIG_DIR=supervisord/programs
SUPERVISOR_LOG_DIR=supervisord/logs

# Systemd Configuration (if STREAM_RUNTIME_MODE=systemd)
SYSTEMD_UNIT_TEMPLATE=ffmpeg@{stream_id}
SYSTEMCTL_PATH=systemctl

# MediaMTX (optional future media-plane relay)
MEDIAMTX_ENABLED=false
MEDIAMTX_RTMP_PUBLISH_URL=rtmp://mediamtx:1935
MEDIAMTX_CONTROL_API_URL=http://mediamtx:9997
MEDIAMTX_METRICS_URL=http://mediamtx:9998/metrics

# Monitoring (optional)
SENTRY_DSN=
# Shared token required for /metrics and /metrics/prometheus endpoints.
METRICS_ACCESS_TOKEN=change_this_metrics_token

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Internal Integrations
# tusd HMAC secret for secure upload hooks (required even for local tusd runs)
TUSD_HMAC_SECRET=GENERATE_RANDOM_TUSD_SECRET
# upload token secret shared between API and tusd hooks (required for local uploads)
UPLOAD_TOKEN_SECRET=GENERATE_RANDOM_UPLOAD_SECRET
