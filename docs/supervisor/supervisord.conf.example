[supervisord]
logfile=/var/log/supervisord.log
pidfile=/var/run/supervisord.pid
childlogdir=/var/log/streams
nocleanup=true

[supervisorctl]
serverurl=unix:///var/run/supervisor.sock

# Repeat a [program] section for each stream UUID you want to keep alive.
[program:stream_6f2a2a8d]
directory=/opt/youtube_translation/backend
command=/opt/youtube_translation/.venv/bin/python -m app.cli.run_stream 6f2a2a8d-1d9c-49b9-b500-511e1c7f7ea3
autostart=true
autorestart=true
startsecs=5
stopwaitsecs=20
stdout_logfile=/var/log/streams/6f2a2a8d.log
stderr_logfile=/var/log/streams/6f2a2a8d.err
environment=PYTHONPATH="/opt/youtube_translation/backend"
