            "url": "{{base_url}}/api/internal/check-quota"
          }
        },
        {
          "name": "Get User Quota",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/quota?user_id={{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "quota"
              ],
              "query": [
